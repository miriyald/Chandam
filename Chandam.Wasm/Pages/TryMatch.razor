@page "/try-match"
@inject ChandamService Service
@inject RuleLoaderService RuleLoader

<h2>Try Match</h2>
<p>Match a poem against a specific Chandam rule.</p>

<PoemInput @bind-PoemText="poemText" @bind-Language="language"
           @bind-MatchYati="matchYati" @bind-MatchPrasa="matchPrasa" />

<div class="card">
    <div class="rule-selector">
        <label>
            Select Rule:
            <select @bind="selectedRule">
                <option value="">-- Select a Chandam --</option>
                @foreach (var rule in availableRules)
                {
                    <option value="@rule.Identifier">@rule.Name (@rule.Identifier)</option>
                }
            </select>
        </label>
    </div>
</div>

<button class="btn btn-primary"
        @onclick="Match"
        disabled="@(string.IsNullOrWhiteSpace(poemText) || string.IsNullOrEmpty(selectedRule) || matching)">
    @(matching ? "Matching..." : "Try Match")
</button>

@if (result != null)
{
    @if (result.Match != null)
    {
        <h3>Result: @(result.IsMatch ? "Match!" : "No Match")</h3>
        <ResultDisplay Match="result.Match" />
    }
    else
    {
        <ResultDisplay ErrorMessage="@result.ErrorMessage" />
    }
}

@code {
    private string poemText = "";
    private string language = "te";
    private bool matchYati = true;
    private bool matchPrasa = true;
    private string selectedRule = "";
    private bool matching;
    private TryMatchResponse? result;
    private List<Chandam.Rules.Rule> availableRules = new();

    protected override void OnInitialized()
    {
        availableRules = RuleLoader.GetAllRules()
            .OrderBy(r => r.Name)
            .ToList();
    }

    private async Task Match()
    {
        matching = true;
        result = null;
        StateHasChanged();

        await Task.Yield();

        var request = new TryMatchRequest
        {
            PoemText = poemText,
            RuleIdentifier = selectedRule,
            MatchYati = matchYati,
            MatchPrasa = matchPrasa
        };

        result = Service.TryMatch(request);
        matching = false;
    }
}
