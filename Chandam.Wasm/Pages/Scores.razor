@page "/scores"
@inject ChandamService Service

<h2>Scores</h2>
<p>Calculate match scores against all rules.</p>

<PoemInput @bind-PoemText="poemText" @bind-Language="language"
           @bind-MatchYati="matchYati" @bind-MatchPrasa="matchPrasa" />

<button class="btn btn-primary" @onclick="Calculate" disabled="@(string.IsNullOrWhiteSpace(poemText) || calculating)">
    @(calculating ? "Calculating..." : "Calculate Scores")
</button>

@if (result != null)
{
    @if (!string.IsNullOrEmpty(result.ErrorMessage))
    {
        <ResultDisplay ErrorMessage="@result.ErrorMessage" />
    }
    else if (result.Scores?.Count > 0)
    {
        <h3>Results (@result.Scores.Count matches out of @result.TotalRulesEvaluated rules)</h3>

        <div class="card">
            <table class="scores-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Match %</th>
                        <th>Type</th>
                        <th>Frequency</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int rank = 1; }
                    @foreach (var score in result.Scores)
                    {
                        <tr>
                            <td>@(rank++)</td>
                            <td>@score.Name</td>
                            <td class="@GetPercentageClass(score.MatchPercentage)">
                                @score.MatchPercentage.ToString("F1")%
                            </td>
                            <td>@score.PadyamType</td>
                            <td>@score.Frequency</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="card"><p>No matches found.</p></div>
    }
}

@code {
    private string poemText = "";
    private string language = "te";
    private bool matchYati = true;
    private bool matchPrasa = true;
    private bool calculating;
    private ScoresResponse? result;

    private async Task Calculate()
    {
        calculating = true;
        result = null;
        StateHasChanged();

        await Task.Yield();

        var langEnum = Chandam.API.Helpers.LanguageCodeMapper.ParseLanguage(language);
        var request = new ScoresRequest
        {
            PoemText = poemText,
            MatchYati = matchYati,
            MatchPrasa = matchPrasa,
            Language = langEnum,
            MinimumMatchPercentage = 1
        };

        result = Service.Scores(request);
        calculating = false;
    }

    private string GetPercentageClass(double percentage) =>
        percentage >= 80 ? "match-high" :
        percentage >= 50 ? "match-medium" : "match-low";
}
